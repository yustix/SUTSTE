# ============================================================
# SUT STE - variables de entorno
# Copia este archivo como .env.local para desarrollo:
#     cp .env.example .env.local
# En Vercel se pegan en Project -> Settings -> Environment Variables.
# ============================================================

# --- Base de datos (obligatoria en produccion) --------------------
# Connection string POOLED del proyecto en https://neon.tech
DATABASE_URL=postgresql://usuario:contrasena@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Sesiones (obligatoria) --------------------------------------
# Cadena larga y aleatoria. Genera una con:  openssl rand -base64 48
AUTH_SECRET=cambia-esta-cadena-por-una-aleatoria-de-verdad

# --- Archivos originales (recomendada) ---------------------------
# La inyecta la integracion de Vercel Blob al conectarla al proyecto.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# --- Resumen con IA (opcional) -----------------------------------
# Sin esto, el resumen se genera en el navegador con el motor local.
# LLM_PROVIDER=openai        # openai | gemini | openrouter
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
